<launch>
    <let name="pid_config_path"
        value="$(find-pkg-share hamr_bringup)/config/hamr_pid_params.yaml" />

    <!-- Launch HAMR Controller -->
    <node pkg="hamr_control_cpp" exec="hamr_controller">
        <param from="$(var pid_config_path)" />
    </node>

    <!-- Launch odom graph -->
    <node pkg="hamr_control" exec="hamr_odom_graph" />

    <!-- Path tracer (publishes /hamr/path and /hamr/path_marker) -->
    <node pkg="hamr_control_cpp" exec="hamr_path_tracer">
        <!-- Optional params -->
        <param name="max_points" value="40000"/>
        <param name="publish_rate_hz" value="10.0"/>
    </node>
</launch>
