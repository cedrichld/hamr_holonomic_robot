<launch>
  <!-- Paths -->
  <let name="urdf_path"  value="$(find-pkg-share hamr_description)/urdf/hamr.urdf.xacro" />
  <let name="gazebo_config_path" value="$(find-pkg-share hamr_bringup)/config/gazebo_bridge.yaml" />
  <let name="rviz_config_path"   value="$(find-pkg-share hamr_description)/rviz/urdf_config.rviz" />
  <let name="pid_config_path"    value="$(find-pkg-share hamr_bringup)/config/hamr_pid_params.yaml" />

  <!-- Switches -->
  <arg name="start_gz"   default="true" />
  <arg name="start_rviz" default="true" />

  <!-- Always publish robot_description so RViz can render -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
  </node>

  <!-- Gazebo + bridge (optional) -->
  <group if="$(var start_gz)">
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
      <arg name="gz_args" value="$(find-pkg-share hamr_bringup)/worlds/empty_world.sdf -r" />
    </include>

    <!-- Spawn from robot_description into Gazebo -->
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" />

    <!-- ROS ⇄ Gazebo bridge -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
      <param name="config_file" value="$(var gazebo_config_path)" />
    </node>
  </group>

  <!-- RViz (optional, on by default) -->
  <group if="$(var start_rviz)">
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" />
  </group>

  <!-- Controller/graph left out here on purpose -->
</launch>
