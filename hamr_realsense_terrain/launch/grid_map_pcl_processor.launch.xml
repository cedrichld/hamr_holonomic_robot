<launch>
    <node pkg="hamr_realsense_terrain"
            exec="grid_map_pcl_processor_node"
            name="grid_map_pcl_processor"
            output="screen">
        <param name="points_topic" value="/camera/camera/depth/color/points"/>
        <param name="map_topic" value="/elevation_map"/>
        <param name="map_frame" value="map"/>
        <param name="params_file" value="$(find-pkg-share hamr_realsense_terrain)/config/pcl_params.yaml"/>
    </node>

    <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
        <arg name="pointcloud.enable" value="true"/>
    </include>
</launch>